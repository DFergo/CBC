## Stage 1: Build admin React app
FROM node:20-slim AS admin-builder

WORKDIR /app/admin

COPY src/admin/package.json src/admin/package-lock.json* ./
RUN npm install

COPY src/admin/ .
RUN npm run build

## Stage 2: Python backend
FROM python:3.11-slim

WORKDIR /app

# Minimal build toolchain for any pip dependency that compiles C/C++ extensions
# (PyStemmer, some sentence-transformers transitive deps). Without this the
# python:3.11-slim image can't build wheels that don't ship pre-built binaries,
# and pip install fails with exit code 1. Removed from the final image size
# via the pip --no-cache-dir; apt cache is also scrubbed.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

# true  → local embedding/reranker stack (PyTorch CPU, sentence-transformers)
#         with BGE-M3, MiniLM and bge-reranker-v2-m3 weights baked in.
# false → no local models; embeddings and reranking go through an API
#         connection configured in Admin (much smaller image).
ARG INSTALL_LOCAL_MODELS=true

# PyTorch CPU-only first so sentence-transformers doesn't drag in the ~5 GB
# CUDA/NVIDIA stack (HRDD pattern). Must come BEFORE the local requirements.
RUN if [ "$INSTALL_LOCAL_MODELS" = "true" ]; then \
        pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu; \
    fi

COPY src/backend/requirements.txt src/backend/requirements-local-models.txt ./
RUN pip install --no-cache-dir -r requirements.txt && \
    if [ "$INSTALL_LOCAL_MODELS" = "true" ]; then \
        pip install --no-cache-dir -r requirements-local-models.txt; \
    fi

# Pre-download the embedding + reranker weights so the first query doesn't hit
# HuggingFace (predictable cold start, works air-gapped). MiniLM is kept as the
# alternative local embedder selectable via deployment_backend.json.
RUN if [ "$INSTALL_LOCAL_MODELS" = "true" ]; then \
        python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; \
SentenceTransformer('BAAI/bge-m3'); \
SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2'); \
CrossEncoder('BAAI/bge-reranker-v2-m3')"; \
    fi

# Application code
COPY src/backend/ ./src/
COPY config/deployment_backend.json ./config/deployment_backend.json

# Built admin SPA (served as fallback by FastAPI)
COPY --from=admin-builder /app/admin/dist /app/admin/dist

# Persistent data dir (mounted from a Docker volume in compose)
RUN mkdir -p /app/data

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
