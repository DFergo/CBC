FRONTEND_TAG=latest
# Public port (users / cloudflared). 127.0.0.1 = only via a tunnel on this machine;
# set PUBLIC_BIND to the LAN IP if office users should reach it directly.
PUBLIC_BIND=127.0.0.1
FRONTEND_PORT=8190
# Backend surface — this machine's LAN IP, reachable by the backend host
BACKEND_BIND=192.168.1.50
FRONTEND_BACKEND_PORT=8191
# signed (default) | trusted-network (no signature check: only if nothing but the
# CBC backend can reach the backend port)
BACKEND_SURFACE_AUTH=signed
# openssl rand -hex 32 — the backend's CBC_FRONTEND_SECRET (installation secret),
# or this frontend's own secret from Admin → Frontends → Security
CBC_BACKEND_SECRET=
CBC_BACKEND_SECRET_PREVIOUS=
