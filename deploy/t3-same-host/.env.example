BACKEND_TAG=latest
FRONTEND_TAG=latest
BACKEND_ADMIN_PORT=8100
FRONTEND_PORT=8190
# signed (default) | trusted-network (backend and frontend share only an internal network)
BACKEND_SURFACE_AUTH=signed
# openssl rand -hex 32 — used as CBC_FRONTEND_SECRET on the backend too,
# so registering http://cbc-frontend:8080 needs only the address
CBC_BACKEND_SECRET=
CBC_BACKEND_SECRET_PREVIOUS=
