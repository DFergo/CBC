# latest (follows main) or sha-<commit> to pin a version
FRONTEND_TAG=latest
# signed (default) | trusted-network (no signature check: only if nothing but the
# CBC backend can reach the backend port)
BACKEND_SURFACE_AUTH=signed
# openssl rand -hex 32 — the backend's CBC_FRONTEND_SECRET (installation secret),
# or this frontend's own secret from Admin → Frontends → Security
CBC_BACKEND_SECRET=
CBC_BACKEND_SECRET_PREVIOUS=
# Cloudflare Zero Trust → Networks → Tunnels → <tunnel> → token
TUNNEL_TOKEN=
